{
  "name": "eduator-ai-v2",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Educational Platform - Transforming learning through intelligent automation",
  "author": "Eduator Team",
  "license": "MIT",
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev:clean-backend": "npm run dev -w @eduator/clean-backend",
    "dev:clean": "npm run dev:clean-backend",
    "build": "npm run build:clean-backend",
    "build:clean-backend": "npm run build -w @eduator/clean-backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules && rm -rf apps/*/node_modules && rm -rf apps/*/.next",
    "prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('npx husky install', {stdio:'inherit'}) }\""
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^10.0.0",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.19.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^1.0.0",
    "cookie": "^0.7.0"
  },
  "dependencies": {
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
