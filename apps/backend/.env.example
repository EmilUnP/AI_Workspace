NODE_ENV=development

HOST=0.0.0.0

PORT=3010

DATABASE_URL=postgres://postgres:postgres@localhost:5432/eduator_clean

JWT_ACCESS_SECRET=replace-with-very-long-secret-32-chars-min

JWT_REFRESH_SECRET=replace-with-very-long-secret-32-chars-min

JWT_ACCESS_TTL=15m

JWT_REFRESH_TTL=7d

# Preferred: platform OpenRouter key (or configure via Platform Owner → AI Providers).
OPENROUTER_API_KEY=sk-or-replace-with-your-openrouter-key

# Separate secret for encrypting stored provider credentials (falls back to JWT_ACCESS_SECRET if empty).
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-another-long-secret-32-chars-min

OPENROUTER_HTTP_REFERER=https://eduator.ai
OPENROUTER_APP_TITLE=Eduator AI
OPENROUTER_TIMEOUT_MS=120000

# Comma-separated allowed browser origins. Empty + NODE_ENV=development allows local CORS.
CORS_ORIGINS=http://localhost:3000

# database = all files in PostgreSQL (documents + lesson images/audio)
# local = files on app server disk (dev only)
FILE_STORAGE=database

# RAG vector search requires pgvector on PostgreSQL (migration 015_pgvector_document_chunks.sql).
# Install on the DB host if missing, e.g. apt install postgresql-16-pgvector

# Only when FILE_STORAGE=local
AI_STORAGE_DIR=./storage

# --- Split deployment (app 10.10.204.11, DB 10.10.204.21) ---
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@10.10.204.21:5432/eduator_clean
# FILE_STORAGE=database
