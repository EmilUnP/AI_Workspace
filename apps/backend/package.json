{
  "name": "@eduator/clean-backend",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "lint:forbidden-imports": "tsx scripts/check-forbidden-imports.ts"
  },
  "dependencies": {
    "@cedrugs/pdf-parse": "^1.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "glob": "^11.0.3",
    "jose": "^6.1.0",
    "mammoth": "^1.11.0",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/word-extractor": "^1.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
