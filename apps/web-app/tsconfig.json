{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@eduator/ui": ["./src/lib/eduator-ui-shim.tsx"],
      "@eduator/auth/supabase/server": ["./src/lib/eduator-auth-server-shim.ts"],
      "@eduator/auth/supabase/client": ["./src/lib/eduator-auth-client-shim.ts"],
      "@eduator/auth/supabase/admin": ["./src/lib/eduator-auth-admin-shim.ts"],
      "@eduator/core/types/token": ["./src/lib/eduator-core-token-shim.ts"],
      "@eduator/core/hooks/useGenerateLesson": ["./src/lib/eduator-core-use-generate-lesson-shim.ts"],
      "@eduator/core/types/education-plan": ["./src/lib/eduator-education-plan-types-shim.ts"],
      "@eduator/core/utils/teacher-education-plans": ["./src/lib/eduator-teacher-education-plans-shim.ts"],
      "@eduator/core/utils/exam-question-normalize": ["./src/lib/eduator-exam-normalize-shim.ts"],
      "@eduator/core/utils/teacher-exams": ["./src/lib/eduator-teacher-exams-shim.ts"],
      "@eduator/core/utils/teacher-lessons": ["./src/lib/eduator-teacher-lessons-shim.ts"],
      "@eduator/ai/services/teacher-chatbot": ["./src/lib/eduator-teacher-chatbot-shim.ts"],
      "@eduator/db": ["./src/lib/eduator-db-shim.ts"],
      "@eduator/db/repositories/tokens": ["./src/lib/eduator-db-tokens-shim.ts"],
      "@eduator/config": ["./src/lib/eduator-config-shim.ts"],
      "@eduator/config/constants": ["./src/lib/eduator-config-constants-shim.ts"],
      "next-intl": ["./src/lib/no-intl-client.ts"],
      "next-intl/server": ["./src/lib/no-intl-server.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
